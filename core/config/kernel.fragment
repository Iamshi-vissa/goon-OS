# Goon OS Core — kernel options merged on top of x86_64_defconfig + kvm_guest.config
CONFIG_LOCALVERSION="-goon"
CONFIG_DEFAULT_HOSTNAME="goon"
# One self-contained kernel: no loadable modules, so every driver is built in
# CONFIG_MODULES is not set
# Boot from an in-memory root filesystem
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# UEFI + BIOS boot and a screen console on both
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Keyboards: PS/2 and USB
CONFIG_KEYBOARD_ATKBD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# Storage, so the optional GOON_DATA persistence disk can be mounted
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# Common wired network cards
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_IGB=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
