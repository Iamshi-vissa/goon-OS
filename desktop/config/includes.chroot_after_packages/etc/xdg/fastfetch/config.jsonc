// Goon OS default fastfetch look. Users can override in ~/.config/fastfetch/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/goon-os/fastfetch-logo.txt",
    "color": { "1": "magenta", "2": "cyan" }
  },
  "display": { "color": { "keys": "magenta" } },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages", "shell",
    "de", "wm", "theme", "icons", "terminal", "cpu", "gpu", "memory", "disk",
    "break", "colors"
  ]
}
